; Engine configuration file.
config_version=5

[application]

config/name="轨道旧货局"
config/description="空间站当铺经营：分层光照场景、实物鉴定、议价与 21 日经营。"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.067, 0.094, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/app/game.gd"
Audio="*res://scripts/app/audio.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/default_scroll_deadzone=16
theme/custom_font="res://assets/fonts/orbital-sans.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.06, 1)
2d/snap/snap_2d_transforms_to_pixel=false

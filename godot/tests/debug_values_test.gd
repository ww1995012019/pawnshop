extends SceneTree
var failures := 0
func _initialize(): call_deferred("run")
func check(ok: bool, message: String):
 print("DEBUG VALUES ","PASS " if ok else "FAIL ",message)
 if not ok: failures+=1
func run():
 if not ResourceLoader.exists("res://scripts/app/debug_values.gd"):
  check(false,"debug values backend exists");quit(1);return
 var debug=load("res://scripts/app/debug_values.gd")
 var game=root.get_node("Game")
 game.new_game("DEBUG-VALUES")
 var initial=game.state.duplicate(true)
 var original_data=debug.snapshot("data").duplicate(true)
 debug.begin_session()
 check(debug.fields("state","cash").any(func(row):return row.path==["cash"]),"search finds cash")
 check(debug.fields("state","").any(func(row):return row.path==["inventory",0,"condition"]),"all nested array numbers are discoverable")
 check(debug.apply("state",["cash"],"12345").ok and game.state.cash==12345,"cash can be edited")
 check(debug.apply("state",["inventory",0,"condition"],"0.73").ok and is_equal_approx(game.state.inventory[0].condition,.73),"nested decimal can be edited")
 check(game.state.inventory[1]==initial.inventory[1],"editing one original leaves neighbors unchanged")
 check(debug.apply("state",["inventory",0,"working"],"true").ok and game.state.inventory[0].working,"boolean can be edited")
 var before=JSON.stringify(game.state)
 for input in ["nan","inf","1e9999","abc"]:
  check(not debug.apply("state",["cash"],input).ok and JSON.stringify(game.state)==before,"invalid numeric input is rejected: "+input)
 check(not debug.apply("state",["missing"],"1").ok,"missing paths cannot add unrelated fields")
 check(not debug.apply("state",["schema"],"7").ok,"save schema remains loadable")
 check(not debug.apply("state",["seed"],"5").ok,"text identifiers cannot be overwritten")
 var persisted=JSON.parse_string(FileAccess.get_file_as_string(game.SAVE_PATH))
 check(persisted.cash==12345 and is_equal_approx(persisted.inventory[0].condition,.73),"state edits survive save serialization")
 var model_id: String=GameData.raw.itemDefs[0].id
 check(debug.apply("data",["content","itemDefs",0,"value"],"2468").ok and GameData.def(model_id).value==2468,"definition edit updates indexed model values")
 GameData.apply_debug_data(original_data)
 debug.load_overrides()
 check(GameData.def(model_id).value==2468,"definition override survives reload")
 check(debug.apply("prefs",["music_volume"],"0.42").ok and is_equal_approx(game.prefs.music_volume,.42),"preference numbers can be edited")
 check(debug.fields("data","WNT-001").any(func(row):return row.path==["wanted_profiles",0,"reward"]),"separate wanted profiles are discoverable")
 check(debug.apply("data",["wanted_profiles",0,"reward"],"333").ok and WantedCases.profiles()[0].reward==333,"wanted reward edits update runtime profiles")
 check(debug.apply("data",["watch_art","WCH-001","dial_style"],"2").ok and WatchLogo.art("WCH-001").dial_style==2,"watch artwork numeric parameters are editable")
 WantedCases._profiles=JSON.parse_string(FileAccess.get_file_as_string("res://data/wanted_profiles.json"))
 WatchLogo._art={}
 debug.load_overrides()
 check(WantedCases.profiles()[0].reward==333 and WatchLogo.art("WCH-001").dial_style==2,"all separate definition overrides survive reload")
 var save_path:=ProjectSettings.globalize_path(game.SAVE_PATH)
 DirAccess.make_dir_absolute(save_path+".debug-tmp")
 check(not debug.apply("state",["cash"],"999").ok and game.state.cash==12345,"blocked staging leaves live state unchanged")
 check(JSON.parse_string(FileAccess.get_file_as_string(game.SAVE_PATH)).cash==12345,"failed replacement preserves the prior valid save")
 DirAccess.remove_absolute(save_path+".debug-tmp")
 var prefs_path:=ProjectSettings.globalize_path(game.PREFS_PATH)
 DirAccess.rename_absolute(prefs_path,prefs_path+".test-held")
 DirAccess.make_dir_absolute(prefs_path)
 check(not debug.restore().ok and game.state.cash==12345 and WantedCases.profiles()[0].reward==333,"failed restore keeps the live edited values")
 check(JSON.parse_string(FileAccess.get_file_as_string(debug.DATA_PATH)).wanted_profiles[0].reward==333 and debug.backed_up,"failed restore preserves persisted edits and original backup")
 DirAccess.remove_absolute(prefs_path)
 DirAccess.rename_absolute(prefs_path+".test-held",prefs_path)
 check(debug.restore().ok,"pre-debug backup can be restored")
 check(game.state.cash==initial.cash and JSON.parse_string(JSON.stringify(game.state.inventory))==JSON.parse_string(JSON.stringify(initial.inventory)),"backup restores the original state")
 check(debug.snapshot("data")==original_data,"backup restores original definitions")
 print("DEBUG VALUES failures=",failures)
 quit(1 if failures else 0)

extends SceneTree
const Commerce = preload("res://scripts/model/commerce.gd")
## Deterministic saves generated by the normal commerce/night reducers.
func _initialize() -> void: call_deferred("run")
static func act(s: Dictionary, type: String, extra := {}) -> Dictionary:
	var a := {"type":type}; a.merge(extra)
	return Commerce.reduce(s,a)
static func fresh(seed: String) -> Dictionary:
	var s := Model.create(seed)
	s.day=3; s.cash=10000; s.inspection="cleared"
	s.inventory=[]
	for id in ["WCH-001", "WCH-002"]:
		var it := Model.new_item(s,id,{"sourceVerified":true,"condition":0.8,"working":true,"authentic":true})
		Model.put_in(s,it)
	return s
static func build() -> Dictionary:
	var before := {}
	var closed := {}
	var opened := {}
	for n in 100000:
		var seed := "NIGHT-UI-%d" % n
		if not NightCrime.theft_draw(seed,3) or Model.fnv("%s/night/count/3" % seed)%100 >= 10: continue
		var s := fresh(seed)
		s = act(s,"ARRIVE_INSPECTION")
		if s.trade != null: s = act(s,"RESOLVE_INSPECTION",{"tradeId":s.trade.id})
		before=s.duplicate(true)
		s=act(s,"BUY_INSURANCE")
		closed=act(s,"SETTLE")
		opened=act(closed,"NEXT")
		if NightCrime.public_report(opened).morning.losses.size()==2: break
	if before.is_empty() or opened.is_empty(): return {}
	var inspection := {}
	for n in 1000:
		var s := fresh("INSPECT-UI-%d" % n)
		# Cursor and AP are ordinary save resources; scheduling uses the real draw.
		s.cursor=6; s.ap=0
		NightCrime.ensure_day(s)
		if NightCrime.inspection_pending(s): inspection=s; break
	var q := NightCrime.insurance_quote(before)
	var morning: Dictionary = NightCrime.public_report(opened).morning
	var uids := []
	for loss in morning.losses: uids.append(loss.uid)
	var meta := {"premium":q.due,"closingFee":closed.report.costs.total+closed.report.rent,"payout":morning.payout,"lossUIDs":uids,"nightDay":3,"openDay":4,"buyButton":"购买今晚保险","ackButton":"确认夜间记录","historyButton":"夜间失窃与查货记录","inspectionButton":"接待查货警察","resolveButton":"配合查货"}
	var result := {"before_insurance":before,"insured_report":closed,"inspection_pending":inspection,"meta":meta}
	return result
func run() -> void:
	var result := build()
	if preload("res://tests/fixture_output.gd").write_json("res://../work/night-crime/browser-fixture.json",result) != OK:
		quit(1);return
	print("NIGHT FIXTURE actual losses=",result.meta.lossUIDs.size()," payout=",result.meta.payout," premium=",result.meta.premium," inspector=",not result.inspection_pending.is_empty())
	quit(0 if result.meta.lossUIDs.size()==2 and not result.inspection_pending.is_empty() else 1)

static func close_day(s: Dictionary) -> Dictionary:
	s=act(s,"ARRIVE_INSPECTION")
	if s.trade != null and s.trade.get("inspectionVisit",false): s=act(s,"RESOLVE_INSPECTION",{"tradeId":s.trade.id})
	return act(s,"SETTLE")
static func resale_state() -> Dictionary:
	for n in 100000:
		var seed := "LOOP-%d" % n
		if not NightCrime.theft_draw(seed,3) or Model.fnv("%s/fence/return/5" % seed)%100>=20: continue
		var s := fresh(seed)
		s.inventory=[s.inventory[1]]
		s=act(close_day(s),"NEXT")
		s=act(close_day(s),"NEXT")
		while s.cursor<6:
			s=act(s,"ARRIVE")
			if s.trade==null: break
			if s.trade.get("crimeCaseId", "").begins_with("NIGHT-"):
				s=act(s,"ACK_NIGHT_REPORT")
				return s
			if s.trade.get("inspectionVisit",false): s=act(s,"RESOLVE_INSPECTION",{"tradeId":s.trade.id})
			else: s=act(s,"REFUSE")
	return {}
